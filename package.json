{
  "title": "RES-Slim",
  "name": "res-slim",
  "version": "0.55.0",
  "description": "Desktop enhancements, privacy controls, and media tools for old and current Reddit",
  "author": "RES-Slim (fork of Reddit Enhancement Suite contributors)",
  "license": "GPL-3.0",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/SysAdminDoc/RES-Slim",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "preinstall": "node scripts/check-toolchain.mjs",
    "prestart": "rimraf dist",
    "start": "node build.js --watch --mode development",
    "preonce": "rimraf dist",
    "once": "node build.js --mode development",
    "prebuild": "rimraf dist",
    "build": "node build.js --mode production --zip --browsers chrome,firefox",
    "test": "node scripts/run-unit-tests.mjs",
    "test:settings": "node --test tests/unit/settings-console-theme.test.mjs",
    "test:show-images": "node --test tests/unit/show-images-hosts.test.mjs",
    "test:privacy": "node --test tests/unit/privacy-outbound-urls.test.mjs",
    "pretest:e2e": "node build.js --mode development",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=120000 tests/e2e/extension.test.mjs tests/e2e/current-thread-parity.test.mjs",
    "eslint": "eslint .",
    "stylelint": "stylelint lib/**/*.scss",
    "test:bundle": "node build.js --mode production --browsers chrome",
    "lint": "node scripts/lint-baseline.mjs && yarn stylelint && node scripts/i18n-lint.mjs",
    "lint:i18n": "node scripts/i18n-lint.mjs",
    "flow": "node scripts/flow-baseline.mjs",
    "flow:baseline": "node scripts/flow-baseline.mjs --update",
    "lint:baseline": "node scripts/lint-baseline.mjs --update",
    "check:endpoints": "node scripts/check-endpoints.mjs",
    "check:metadata": "node scripts/check-metadata.mjs",
    "verify": "node scripts/verify.mjs",
    "bundle:baseline": "node build.js --mode production --browsers chrome,firefox --update-bundle-baseline",
    "fixture:import": "node scripts/import-old-reddit-fixture.mjs",
    "firefox:audit": "node tests/firefox/audit.mjs",
    "manifest": "node scripts/generate-manifests.mjs",
    "manifest:check": "node scripts/generate-manifests.mjs --check",
    "release": "node scripts/release.mjs",
    "publish:release": "node scripts/publish.mjs"
  },
  "browserslist": [
    "chrome 125",
    "firefox 130"
  ],
  "dependencies": {
    "dashjs": "5.2.1",
    "dompurify": "3.4.14",
    "fastest-levenshtein": "1.0.16",
    "snudown-js": "4.1.0"
  },
  "resolutions": {
    "postcss": "8.5.28",
    "fast-uri": "3.1.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^8",
    "@babel/eslint-parser": "^8",
    "@babel/generator": "8.0.0",
    "@babel/parser": "8.0.4",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "commander": "12.1.0",
    "cross-env": "7.0.3",
    "esbuild": "0.28.2",
    "esbuild-plugin-copy": "2.1.1",
    "esbuild-sass-plugin": "3.7.0",
    "eslint": "10.10.0",
    "eslint-plugin-ava": "17.0.1",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-flowtype": "8.0.3",
    "eslint-plugin-import-x": "4.17.1",
    "flow-bin": "0.84.0",
    "flow-remove-types": "2.246.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "jszip": "3.10.1",
    "playwright": "^1.63.0",
    "postcss": "8.5.28",
    "puppeteer-core": "^25.10.0",
    "rimraf": "6.1.3",
    "semver": "7.8.5",
    "stylelint": "17.15.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-config-sass-guidelines": "13.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-scss": "7.2.0"
  }
}
