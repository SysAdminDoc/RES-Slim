// Flow 0.84 ships the 2018 DOM, which predates `AbortController`. It is Chrome
// 66 and Firefox 57, so it is a decade inside this project's floor
// (`browserslist` in package.json), and the checker having never heard of it is
// a fact about the checker.
//
// Same shape as `intl.js.flow` next door, and for the same reason: the libs
// directory is where a browser-support decision belongs, because there it is
// enforceable. A cast at the call site would assert the same thing and check
// nothing.
//
// `AbortSignal.timeout()` is declared as of 2026-09-08, because the codebase now
// uses it: every outbound request carries one. Measured against webstatus.dev on
// that date — Chrome 124 (2024-04-16), Firefox 100 (2022-05-03) — against a
// floor of chrome 125 / firefox 130, so it clears both. That check is the reason
// this belongs here rather than in a cast at the call site.
//
// `signal.reason` is still deliberately left out: nothing reads it, so reaching
// for one stays a type error rather than a runtime surprise.

declare class AbortSignal extends EventTarget {
	+aborted: boolean;
	onabort: ?(event: Event) => mixed;
	static timeout(milliseconds: number): AbortSignal;
	static any(signals: Array<AbortSignal>): AbortSignal;
}

declare class AbortController {
	constructor(): void;
	+signal: AbortSignal;
	abort(): void;
}
