// Flow 0.84's `CustomElementRegistry` has `define`, `get` and `whenDefined` and
// stops there. `upgrade()` is Chrome 68 and Firefox 63, so it is well inside this
// project's floor (`browserslist` in package.json), and the checker not knowing
// about it is a fact about the checker.
//
// It is the one call that closes the shadow-root race for good: a host seen
// between being parsed and being upgraded has no shadow root yet, and `upgrade()`
// runs its constructor synchronously instead of waiting on the scheduler and
// hoping. `lib/utils/shreddit.js` used one `requestAnimationFrame` for that, and
// the same assumption is the documented cause of failures in three other
// extensions.
//
// Third libdef in here, same pattern as `intl.js.flow` and `abort.js.flow`: the
// libs directory is where a browser-support decision belongs, because there it is
// checked. A cast at the call site asserts the same thing and checks nothing.
//
// `customElements` itself is redeclared because Flow's core declares it as a var
// of this interface type, and the interface cannot be extended piecemeal.

declare interface CustomElementRegistry {
	define(name: string, ctor: Class<Element>, options?: ElementDefinitionOptions): void;
	get(name: string): any;
	whenDefined(name: string): Promise<void>;
	upgrade(root: Node): void;
}
